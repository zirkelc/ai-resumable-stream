{
  "name": "ai-resumable-stream",
  "version": "2.0.0",
  "description": "Resume and stop AI SDK streams, backed by S3, Redis, or any store you provide",
  "keywords": [
    "ai",
    "ai-sdk",
    "redis",
    "resumable",
    "resumable-stream",
    "s3",
    "stream"
  ],
  "license": "MIT",
  "author": "Chris Cook",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zirkelc/ai-resumable-stream.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./adapters/redis": "./dist/adapters/redis/index.mjs",
    "./adapters/s3-express": "./dist/adapters/s3-express/index.mjs",
    "./ai-sdk": "./dist/ai-sdk/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "example:redis": "tsx examples/redis.ts",
    "example:s3-express": "tsx examples/s3-express.ts",
    "lint": "oxlint --fix",
    "lint:ci": "oxlint",
    "format": "oxfmt --write",
    "format:ci": "oxfmt --check",
    "prepare": "husky"
  },
  "dependencies": {
    "ai-stream-utils": "^3.1.1",
    "resumable-stream": "^2.2.12"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.3",
    "@arethetypeswrong/cli": "^0.18.5",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "ai": "^7.0.22",
    "ai-test-kit": "^3.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "pkg-pr-new": "^0.0.75",
    "publint": "^0.3.21",
    "redis": "^6.1.0",
    "redis-memory-server": "^0.17.0",
    "redis-v5": "npm:redis@^5.12.1",
    "redis-v6": "npm:redis@^6.1.0",
    "tsdown": "^0.22.7",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "ai": "^7.0.0",
    "redis": "^5.0.0 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "redis": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx}": [
      "pnpm lint",
      "pnpm format"
    ],
    "*.{json,jsonc}": [
      "pnpm format"
    ]
  },
  "packageManager": "pnpm@10.29.3"
}
