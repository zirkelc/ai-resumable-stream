{
  "name": "ai-resumable-stream",
  "version": "1.4.0",
  "description": "AI SDK: resume and stop UI message streams",
  "keywords": [
    "ai",
    "ai-sdk",
    "redis",
    "resumable",
    "resumable-stream",
    "stream"
  ],
  "license": "MIT",
  "author": "Chris Cook",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zirkelc/ai-resumable-stream.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "tsdown",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --fix",
    "lint:ci": "oxlint",
    "format": "oxfmt --write",
    "format:ci": "oxfmt --check",
    "prepare": "husky"
  },
  "dependencies": {
    "ai-stream-utils": "^3.1.1",
    "resumable-stream": "^2.2.12"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.3",
    "@arethetypeswrong/cli": "^0.18.5",
    "@total-typescript/tsconfig": "^1.0.4",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "ai": "^7.0.22",
    "ai-test-kit": "^3.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "mitata": "^1.0.34",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "pkg-pr-new": "^0.0.75",
    "publint": "^0.3.21",
    "redis": "^6.1.0",
    "redis-memory-server": "^0.17.0",
    "redis-v5": "npm:redis@^5.12.1",
    "redis-v6": "npm:redis@^6.1.0",
    "tsdown": "^0.22.7",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "redis": "^5.0.0 || ^6.0.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx}": [
      "pnpm lint",
      "pnpm format"
    ],
    "*.{json,jsonc}": [
      "pnpm format"
    ]
  },
  "packageManager": "pnpm@10.29.3"
}
